{
  "manifest_version": 3,
  "name": "GCE启动器",
  "version": "1.1.0",
  "description": "新标签页：多引擎搜索、书签网格、Dock、记事本与网页悬浮工具，数据仅保存在本机。",
  "homepage_url": "https://github.com/powerglq/gce",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "favicon",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' data: https: http:"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GCE启动器",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab-build/index.html"
  }
}
